# Claude API 配置。复制为 .env 后填写；不得提交真实密钥。
ANTHROPIC_API_KEY=

# 使用 Anthropic 官方 API 时留空；兼容服务必须填写其准确接口地址。
ANTHROPIC_BASE_URL=

# 填写目标 API 实际支持的模型 ID。
ANTHROPIC_MODEL=

# 当前笔试默认使用 Anthropic 或 Anthropic 兼容接口。
API_PROVIDER=anthropic

# 本地 PostgreSQL。默认值仅用于开发环境。
POSTGRES_USER=computeruse
POSTGRES_PASSWORD=computeruse_dev
POSTGRES_DB=computeruse

# Sandbox 资源限制。noVNC 默认只绑定本机随机端口。
SANDBOX_PUBLIC_HOST=127.0.0.1
SANDBOX_MEMORY_LIMIT=768m
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=256
SANDBOX_SHM_SIZE=256m
VNC_ACCESS_TTL_SECONDS=120
